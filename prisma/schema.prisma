generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  progress      WordProgress[]
  dailyRecords  DailyRecord[]
  reviewEvents  ReviewEvent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LanguagePair {
  id          String @id
  sourceLang  String
  targetLang  String
  sourceName  String
  targetName  String
  levels      Level[]
}

model Level {
  id          String  @id
  name        String
  nameHe      String
  sourceLang  String  @default("hu")
  targetLang  String  @default("he")
  pairId      String?
  pair        LanguagePair? @relation(fields: [pairId], references: [id])
  topics      Topic[]
}

model Topic {
  id      String @id
  levelId  String
  name    String
  nameHe  String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  words   Word[]

  @@index([levelId])
}

model Word {
  id         String         @id
  topicId    String
  sourceText String
  targetText String
  topic      Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress   WordProgress[]
  reviewEvents ReviewEvent[]

  @@index([topicId])
}

model WordProgress {
  id           String   @id @default(cuid())
  wordId       String
  userId       String
  status       String   @default("unknown")
  lastReviewed BigInt   @default(0)
  reviewCount  Int      @default(0)
  nextReview   BigInt   @default(0)
  /// How many times the word has been put in front of the learner, counting
  /// the sittings where it was introduced as well as the ones where it was
  /// asked for. Always at least `reviewCount`.
  seenCount    Int      @default(0)
  /// How often a word the learner had known came back unknown. The count that
  /// says a word is not sticking, which `status` alone cannot show.
  lapses       Int      @default(0)
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([wordId, userId])
  @@index([userId])
}

model DailyRecord {
  id        String @id @default(cuid())
  userId    String
  date      String
  count     Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

/// One card, answered. An append-only log: `WordProgress` says where a word
/// stands, and this says how it got there, which is what makes it possible to
/// ask whether a learner is improving rather than only what they last pressed.
model ReviewEvent {
  id             String  @id @default(cuid())
  userId         String
  wordId         String
  /// `forward` shows the Hungarian and asks for the Hebrew; `reverse` is the
  /// other way round. Kept per event so the two can be told apart later, before
  /// they are scheduled apart.
  direction      String
  /// `teach` for a word being met, `review` for one being asked about.
  mode           String
  /// How the answer arrived: speech, buttons, quiz, writing, or reveal, which
  /// is the learner admitting they could not recall it.
  source         String
  /// The grade recorded.
  status         String
  /// True when the learner overturned the grade rather than earning it.
  corrected      Boolean @default(false)
  /// Time from the card appearing to the answer, in milliseconds. Null when it
  /// could not be measured.
  latencyMs      Int?
  /// How many times the learner spoke on this card before it was settled.
  spokenAttempts Int     @default(0)
  reviewedAt     BigInt
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([userId, wordId])
}
